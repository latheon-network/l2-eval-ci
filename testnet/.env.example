# Copy to .env (setup-server.sh does it) and set the two host names.
RPC_HOST=rpc.testnet.latheon.xyz
EXPLORER_HOST=explorer.testnet.latheon.xyz

# Pinned images (rehearsed in CI before changing)
NITRO_IMAGE=offchainlabs/nitro-node:v3.11.2-3599aca
BLOCKSCOUT_TAG=9.0.2
FRONTEND_TAG=v2.3.1
CADDY_TAG=2.11.7

# Filled by setup-server.sh (random), do not share
BS_DB_PASSWORD=
BS_SECRET_KEY_BASE=

# Empty on the server. CI only: TLS_LINE=tls internal
TLS_LINE=
# Empty on the server: nitro's default batch posting delay. CI: 30s
BATCH_MAX_DELAY=
# Empty on the server (waits for parent-chain finality of the rollup deployment once).
NITRO_EXTRA_ARGS=
# Empty on the server. CI only: 1 (the validator reads the latest Arbitrum Sepolia blocks instead of finalized ones,
# posts every 30 s) together with CONFIRM_PERIOD_BLOCKS=10 and MIN_ASSERTION_PERIOD_BLOCKS=5 set at chain creation.
BOLD_FAST=
CONFIRM_PERIOD_BLOCKS=
MIN_ASSERTION_PERIOD_BLOCKS=
# Arbitrum Sepolia RPC for the node and scripts. It must answer eth_getLogs over wide block ranges: the node reads the
# inbox and assertions in chunks of up to thousands of blocks. Free Alchemy (10 blocks) and free QuickNode (5) do not work:
# the node retries forever and never sees deposits. How to check a candidate: README-RU.md.
# Works without a key (checked 20 Oct 2026): https://arbitrum-sepolia-rpc.publicnode.com, https://sepolia-rollup.arbitrum.io/rpc
PARENT_RPC=https://arbitrum-sepolia-rpc.publicnode.com

# Faucet of test LTH (https://EXPLORER_HOST/faucet): LTH per claim, hours between claims per address and per IP,
# LTH per 24 hours in total. Empty = 100 / 24 / 5000.
FAUCET_AMOUNT=
FAUCET_COOLDOWN_HOURS=
FAUCET_DAILY_CAP=
