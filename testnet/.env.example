# Copy to .env (setup-server.sh does it) and set the two host names.
RPC_HOST=rpc.testnet.latheon.xyz
EXPLORER_HOST=explorer.testnet.latheon.xyz

# Pinned images (rehearsed in CI before changing)
NITRO_IMAGE=offchainlabs/nitro-node:v3.11.2-3599aca
BLOCKSCOUT_TAG=9.0.2
FRONTEND_TAG=v2.3.1
CADDY_TAG=2.11.7

# Filled by setup-server.sh (random), do not share
BS_DB_PASSWORD=
BS_SECRET_KEY_BASE=

# Empty on the server. CI only: TLS_LINE=tls internal
TLS_LINE=
# Empty on the server: nitro's default batch posting delay. CI: 30s
BATCH_MAX_DELAY=
# Empty on the server (waits for parent-chain finality of the rollup deployment once).
NITRO_EXTRA_ARGS=
# Arbitrum Sepolia RPC for the node and scripts (strongly recommended: your own Alchemy/Infura URL; it is a secret)
PARENT_RPC=https://sepolia-rollup.arbitrum.io/rpc
