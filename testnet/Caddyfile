# Public endpoints. Certificates come from Let's Encrypt automatically once DNS points here.
# TLS_LINE is empty on the server; CI sets it to "tls internal" (self-signed, localhost names).
# Rate limits per client IP (429 with Retry-After when exceeded); defaults below, overridable in .env.
# A JSON-RPC batch counts as one request; its size is capped by the 1 MB body limit.

{
	order rate_limit before reverse_proxy
}

{$RPC_HOST} {
	{$TLS_LINE}
	request_body {
		max_size 1MB
	}
	rate_limit {
		zone rpc_second {
			key {remote_host}
			events {$RPC_RATE_PER_SECOND:25}
			window 1s
		}
		zone rpc_minute {
			key {remote_host}
			events {$RPC_RATE_PER_MINUTE:600}
			window 1m
		}
	}
	reverse_proxy nitro:8449
}

{$EXPLORER_HOST} {
	{$TLS_LINE}
	# operator dashboard (static PWA in ops/, data written by the bot); public data only
	handle_path /ops/data/* {
		header Cache-Control "no-store"
		root * /srv/ops-data
		file_server
	}
	redir /ops /ops/ 308
	handle_path /ops/* {
		root * /srv/ops
		file_server
	}
	handle /faucet* {
		request_body {
			max_size 4KB
		}
		reverse_proxy faucet:8080
	}
	@api path /api /api/* /socket /socket/* /sitemap.xml
	handle @api {
		rate_limit {
			zone api_second {
				key {remote_host}
				events {$API_RATE_PER_SECOND:40}
				window 1s
			}
			zone api_minute {
				key {remote_host}
				events {$API_RATE_PER_MINUTE:1200}
				window 1m
			}
		}
		reverse_proxy blockscout:4000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
